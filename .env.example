# XSpace Analyzer configuration. Copy to `.env` and adjust.
# NEVER commit .env. It is git-ignored.

# --- storage -----------------------------------------------------------------
# Windows path where recordings/artifacts are stored (bind-mounted into Docker).
# Keep this OUTSIDE OneDrive-synced folders.
XSA_DATA_DIR=D:/XSpaceAnalyzer/data

# --- network -----------------------------------------------------------------
# Services bind to localhost only. Set to 0.0.0.0 ONLY if you really want LAN access.
XSA_BIND_HOST=127.0.0.1
XSA_API_PORT=8765
XSA_NOVNC_PORT=6080

# --- logging -----------------------------------------------------------------
XSA_LOG_LEVEL=INFO

# --- monitoring & privacy ----------------------------------------------------
XSA_POLL_INTERVAL_SECONDS=300
XSA_MAX_ACTIVE_ACCOUNTS=10
XSA_MAX_GRAPHQL_REQUESTS_PER_CYCLE=60
XSA_ACCOUNT_POLL_SPACING_SECONDS=5
XSA_ACCOUNT_POLL_JITTER_SECONDS=1
XSA_SIDEBAR_SCAN_INTERVAL_SECONDS=600
XSA_MAX_CONCURRENT_RECORDINGS=2
XSA_CAPTURE_RECOVERY_TIMEOUT_SECONDS=120
XSA_MAX_CAPTURE_RECOVERIES=3
# Repeated explicit end evidence confirmation (0-5 seconds; default 2).
XSA_END_CONFIRM_SECONDS=2
# Sustained low audio level triggers an exact-Space end recheck; stop silent or unmeasurable capture after 7 minutes.
# This stops recording only. X must still provide explicit evidence before the Space is labeled ENDED.
XSA_SILENCE_SUSPECT_SECONDS=180
XSA_SILENCE_CAPTURE_STOP_SECONDS=420
XSA_SILENCE_NOISE_DB=-50
# Anonymous listening: prefer platform's built-in incognito/anonymous listen mode
XSA_PREFER_ANONYMOUS_LISTENING=true
# If anonymous listening is unavailable on the Space, allow authenticated listening fallback.
# The identity exposure guard always runs after joining and will abort if the profile is visible.
# Setting this to true maximises Space coverage while keeping identity protection active.
XSA_ALLOW_AUTHENTICATED_FALLBACK=true

# --- recording ---------------------------------------------------------------
XSA_RECORD_FPS=25
XSA_RECORD_SIZE=720x1280
# x264 (CPU, default, keeps GPU free for Whisper) | nvenc
XSA_VIDEO_ENCODER=x264
XSA_MIN_FREE_DISK_GB=20

# --- optional X API detector (leave empty to use browser-only detection) -----
X_API_BEARER_TOKEN=

# --- transcription -----------------------------------------------------------
# faster-whisper | whisperx
XSA_TRANSCRIBE_ENGINE=faster-whisper
XSA_WHISPER_MODEL=large-v3
XSA_WHISPER_COMPUTE_TYPE=int8_float16
# empty = auto-detect; "ar" forces Arabic
XSA_WHISPER_LANGUAGE=
# Passed only to the optional isolated diarization worker. Accept the model
# terms on Hugging Face first; never put a real token in this example file.
HF_TOKEN=
XSA_DIARIZATION_DEVICE=auto
XSA_DIARIZATION_POLL_SECONDS=30
XSA_DIARIZATION_MERGE_GAP_SECONDS=0.1

# --- local LLM (OpenAI-compatible, e.g. LM Studio). Empty = disabled ----------
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
